__MAIN:             MOVZ    R1, #10
                    MOVZ    R2, #0xCD
                    BRL     MULTIPLY
ALL_DONE:           HALT
MULTIPLY:           PUSH    R1, R2
                    ORS     R3, R0, R0
NEXT_PART_SUM:      LSR     R2, #1
                    BR.CC   NO_PART_SUM
                    SRCC
                    ADD     R3, R3, R1
NO_PART_SUM:        LSL     R1, #1
                    CMP     R2, #0
                    BR.NE   NEXT_PART_SUM
                    POP     R2, R1
                    RET