__MAIN:             MV0L    R7, __STACK_TOP@LSB
                    BR      OVER_STACK
__STACK_BOTTOM:     DS      16
__STACK_TOP:
OVER_STACK:         MVH0    R3, #0x40
                    MV0L    R4, #3
PI_LOOP:            MOV     R1, R4
                    BRL     ONE_OVER_N
                    ORS     R0, R1, R0
                    BR.EQ   LOCKUP
                    SUB     R3, R3, R1
                    ADD     R1, R4, #2
                    BRL     ONE_OVER_N
                    ORS     R0, R1, R0
                    BR.EQ   LOCKUP
                    ADD     R3, R3, R1
                    SRCC
                    ADDS    R4, #4
                    BR.PL   PI_LOOP
LOCKUP:             BR      LOCKUP
ONE_OVER_N:         BITS    R1
                    B.EQ    L
                    CMP     R1, #1
                    BR.NE   NOT_ONE
RETURN_ONE:         MV0H    R1, #0x40
                    RET
NOT_ONE:            PUSH    R2, R3, R4, R5
                    MV0     R3
                    MV0L    R2, #2
                    MV0     R4
                    MV0L    R5, #14
DIV_LOOP:           SHL     R4, R4, #1
                    CMP     R3, R0
                    BR.NE   ADJUST_REMAINDER
                    CMP     R2, R1
                    BR.CS   NEXT_ITERATION
ADJUST_REMAINDER:   SRCC
                    SUBS    R2, R2, R1
                    SUBS    R3, R3, R0
                    OR      R4, #0b1
NEXT_ITERATION:     SRCC
                    SUBS    R5, R5, #1
                    BR.EQ   EXIT_LOOP
                    BIT     R2, #15
                    SHCL    R3, R3, #1
                    SHL     R2, R2, #1
                    BR      DIV_LOOP
EXIT_LOOP:          CMP     R3, R0
                    BR.NE   ROUND_UP
                    BIT     R2, #15
                    SHCL    R3, R3, #1
                    SHL     R2, R2, #1
                    CMP     R2, R1
                    BR.CS   EXIT_FN
ROUND_UP:           ADD     R4, #1
EXIT_FN:            MOV     R1, R4
CLEANUP_FN:         POP     R5, R4, R3, R2
                    RET