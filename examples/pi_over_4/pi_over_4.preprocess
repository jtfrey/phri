__MAIN:             MOV.L   R7, __STACK@LSB
                    BR      OVER_STACK
__STACK:            DS      16
OVER_STACK:         MOV.H   R3, #0x40
                    MOV.L   R4, #3
PI_LOOP:            MOV     R1, R4
                    BRL     ONE_OVER_N
                    ORS     R0, R1, R0
                    BR.EQ   LOCKUP
                    SRCC
                    SUB     R3, R3, R1
                    ADD     R1, R4, #2
                    BRL     ONE_OVER_N
                    ORS     R0, R1, R0
                    BR.EQ   LOCKUP
                    SRCC
                    ADD     R3, R3, R1
                    ADDS    R4, #4
                    BR.PL   PI_LOOP
LOCKUP:             HALT
ONE_OVER_N:         BITS    R1
                    B.EQ    L
                    CMP     R1, #1
                    BR.NE   NOT_ONE
RETURN_ONE:         MOV.H   R1, #0x40
                    RET
NOT_ONE:            PUSH    R2, R3, R4, R5
                    MV0     R3
                    MOV.L   R2, #2
                    MV0     R4
                    MOV.L   R5, #14
DIV_LOOP:           SRCC
                    LSL     R4, R4, #1
                    CMP     R3, R0
                    BR.NE   ADJUST_REMAINDER
                    CMP     R2, R1
                    BR.CS   NEXT_ITERATION
ADJUST_REMAINDER:   SRCC
                    SUBS    R2, R2, R1
                    SUBS    R3, R3, R0
                    OR      R4, #0b1
NEXT_ITERATION:     SRCC
                    SUBS    R5, R5, #1
                    BR.EQ   EXIT_LOOP
                    SRCC
                    LSL     R2, R2, #1
                    LSL     R3, R3, #1
                    BR      DIV_LOOP
EXIT_LOOP:          CMP     R3, R0
                    BR.NE   ROUND_UP
                    SRCC
                    LSL     R2, R2, #1
                    LSL     R3, R3, #1
                    CMP     R2, R1
                    BR.CS   EXIT_FN
ROUND_UP:           ADD     R4, #1
EXIT_FN:            MOV     R1, R4
CLEANUP_FN:         POP     R5, R4, R3, R2
                    RET
